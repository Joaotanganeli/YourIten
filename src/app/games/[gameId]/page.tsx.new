'use client'

import { useState, useEffect } from 'react'
import { useParams, useRouter } from 'next/navigation'
import Link from 'next/link'
import { useAuth } from '@/contexts/AuthContext'
import { FixedService, EloRank, BoostConfig } from '@/types'
import { apiClient } from '@/lib/api-client'
import { 
  ArrowLeft, TrendingUp, Star, Zap, Shield, CheckCircle, User, Search, 
  Coins, Package, ChevronRight, ChevronDown, Clock, MessageCircle, Heart
} from 'lucide-react'

interface Product {
  id: string
  title: string
  description: string
  price: number
  stock: number
  imageUrl: string
  category: string
  game: string
  productType: string
  server?: string
  rank?: string
  level?: number
  blueEssence?: number
  championsCount?: number
  skinsCount?: number
  isHandmade?: boolean
  isRankedReady?: boolean
  sellerName: string
  sellerRating: number
  sellerTotalSales: number
  sellerTotalReviews: number
}

type CategoryType = 'accounts' | 'rp' | 'division_boost' | 'placement' | 'win_boost' | 'coaching'
type QueueType = 'solo' | 'flex'
type CompletionMethod = 'piloted' | 'duo'

interface RankInfo { id: EloRank; name: string; divisions: number }

const GAME_RANKS: Record<string, RankInfo[]> = {
  'league_of_legends': [
    { id: 'iron', name: 'Iron', divisions: 4 },
    { id: 'bronze', name: 'Bronze', divisions: 4 },
    { id: 'silver', name: 'Silver', divisions: 4 },
    { id: 'gold', name: 'Gold', divisions: 4 },
    { id: 'platinum', name: 'Platinum', divisions: 4 },
    { id: 'emerald', name: 'Emerald', divisions: 4 },
    { id: 'diamond', name: 'Diamond', divisions: 4 },
    { id: 'master', name: 'Master', divisions: 1 },
    { id: 'grandmaster', name: 'Grandmaster', divisions: 1 },
    { id: 'challenger', name: 'Challenger', divisions: 1 },
  ],
  'valorant': [
    { id: 'iron', name: 'Iron', divisions: 3 },
    { id: 'bronze', name: 'Bronze', divisions: 3 },
    { id: 'silver', name: 'Silver', divisions: 3 },
    { id: 'gold', name: 'Gold', divisions: 3 },
    { id: 'platinum', name: 'Platinum', divisions: 3 },
    { id: 'diamond', name: 'Diamond', divisions: 3 },
    { id: 'ascendant', name: 'Ascendant', divisions: 3 },
    { id: 'immortal', name: 'Immortal', divisions: 3 },
    { id: 'radiant', name: 'Radiant', divisions: 1 },
  ],
  'deadlock': [
    { id: 'bronze', name: 'Initiate', divisions: 6 },
    { id: 'silver', name: 'Seeker', divisions: 6 },
    { id: 'gold', name: 'Alchemist', divisions: 6 },
    { id: 'platinum', name: 'Arcanist', divisions: 6 },
    { id: 'diamond', name: 'Ritualist', divisions: 6 },
    { id: 'master', name: 'Emissary', divisions: 6 },
  ],
  'dota2': [
    { id: 'herald', name: 'Herald', divisions: 5 },
    { id: 'guardian', name: 'Guardian', divisions: 5 },
    { id: 'crusader', name: 'Crusader', divisions: 5 },
    { id: 'archon', name: 'Archon', divisions: 5 },
    { id: 'legend', name: 'Legend', divisions: 5 },
    { id: 'ancient', name: 'Ancient', divisions: 5 },
    { id: 'divine', name: 'Divine', divisions: 5 },
  ],
}

const GAME_SERVERS: Record<string, string[]> = {
  'league_of_legends': ['NA', 'EUW', 'EUNE', 'KR', 'BR', 'LAN', 'LAS', 'OCE', 'RU', 'TR', 'JP'],
  'valorant': ['NA', 'EU', 'KR', 'BR', 'LATAM', 'AP'],
  'deadlock': ['NA', 'EU', 'ASIA'],
  'dota2': ['US East', 'US West', 'EU West', 'EU East', 'SEA', 'China'],
}

const LP_OPTIONS = [
  { value: 'low', label: 'Low (0-10)', modifier: 1.2 },
  { value: 'normal', label: 'Normal (11-20)', modifier: 1.0 },
  { value: 'high', label: 'High (21+)', modifier: 0.9 },
]

const LOL_ROLES = ['Any Role', 'Top', 'Jungle', 'Mid', 'ADC', 'Support']

export default function GameDetailPage() {
  const params = useParams()
  const router = useRouter()
  const gameId = params.gameId as string
  const { user } = useAuth()
  
  const [products, setProducts] = useState<Product[]>([])
  const [loading, setLoading] = useState(true)
  const [selectedCategory, setSelectedCategory] = useState<CategoryType>('division_boost')
  const [searchTerm, setSearchTerm] = useState('')
  const [serverFilter, setServerFilter] = useState('all')
  const [rankFilter, setRankFilter] = useState('all')
  
  const [boostServer, setBoostServer] = useState('NA')
  const [currentRank, setCurrentRank] = useState<EloRank>('iron')
  const [currentDivision, setCurrentDivision] = useState(4)
  const [desiredRank, setDesiredRank] = useState<EloRank>('gold')
  const [desiredDivision, setDesiredDivision] = useState(4)
  const [lpPerWin, setLpPerWin] = useState('normal')
  const [queueType, setQueueType] = useState<QueueType>('solo')
  const [completionMethod, setCompletionMethod] = useState<CompletionMethod>('piloted')
  const [selectedRole, setSelectedRole] = useState('Any Role')
  const [availableServices, setAvailableServices] = useState<FixedService[]>([])
  const [extras, setExtras] = useState({ priorityOrder: false, streaming: false, specificRoles: false, specificChampions: false, offlineMode: false })
  const [purchaseSuccess, setPurchaseSuccess] = useState(false)

  const isBoostingCategory = (cat: CategoryType) => ['division_boost', 'placement', 'win_boost', 'coaching'].includes(cat)
  const gameRanks = GAME_RANKS[gameId] || GAME_RANKS['league_of_legends']
  const gameServers = GAME_SERVERS[gameId] || GAME_SERVERS['league_of_legends']

  useEffect(() => { loadData(); loadServices() }, [gameId, selectedCategory])

  const loadServices = async () => {
    try {
      const services = await apiClient.services.list({ activeOnly: true, game: gameId })
      setAvailableServices(services)
    } catch (error) { console.error('Failed to load services:', error) }
  }

  const loadData = async () => {
    setLoading(true)
    try {
      if (!isBoostingCategory(selectedCategory)) {
        const productType = selectedCategory === 'accounts' ? 'account' : selectedCategory
        const response = await fetch(`/api/products?game=${gameId}&productType=${productType}`)
        const data = await response.json()
        const convertedProducts = data.map((p: any) => ({
          id: p.id, title: p.title, description: p.description,
          price: typeof p.price === 'string' ? parseFloat(p.price) : p.price,
          stock: typeof p.stock === 'string' ? parseInt(p.stock) : p.stock,
          imageUrl: p.image_url, category: p.category, game: p.game, productType: p.product_type,
          server: p.server, rank: p.rank, level: p.level, blueEssence: p.blue_essence,
          championsCount: p.champions_count, skinsCount: p.skins_count,
          isHandmade: p.is_handmade, isRankedReady: p.is_ranked_ready,
          sellerName: p.seller_name || 'Unknown',
          sellerRating: p.seller_rating ? parseFloat(p.seller_rating) : 5.0,
          sellerTotalSales: p.seller_total_sales || 0, sellerTotalReviews: p.seller_total_reviews || 0
        }))
        setProducts(convertedProducts)
      }
    } catch (error) { console.error('Failed to load data:', error) }
    finally { setLoading(false) }
  }

  const categories = [
    { id: 'division_boost' as CategoryType, name: 'Division Boost', icon: TrendingUp },
    { id: 'placement' as CategoryType, name: 'Placement Matches', icon: Zap },
    { id: 'win_boost' as CategoryType, name: 'Win Boost', icon: Shield },
    { id: 'coaching' as CategoryType, name: 'Coaching', icon: CheckCircle },
    { id: 'accounts' as CategoryType, name: 'Accounts', icon: User },
    { id: 'rp' as CategoryType, name: 'RP', icon: Coins },
  ]

  const getGameName = () => {
    const names: Record<string, string> = { 'league_of_legends': 'League of Legends', 'valorant': 'Valorant', 'dota2': 'Dota 2', 'deadlock': 'Deadlock', 'clash_royale': 'Clash Royale', 'arc_raiders': 'Arc Raiders' }
    return names[gameId] || gameId
  }

  const getCurrencyName = () => {
    const currencies: Record<string, string> = { 'league_of_legends': 'RP', 'valorant': 'VP', 'clash_royale': 'Gems', 'dota2': 'Dota Plus' }
    return currencies[gameId] || 'Currency'
  }

  const getCategoryTitle = () => {
    const titles: Record<CategoryType, string> = { 'division_boost': 'Elo Boost', 'placement': 'Placement Matches', 'win_boost': 'Win Boost', 'coaching': 'Coaching', 'accounts': 'Accounts', 'rp': getCurrencyName() }
    return titles[selectedCategory]
  }

  const handleProductClick = (productId: string) => router.push(`/products/${productId}`)

  const calculatePrice = (): number => {
    let basePrice = 5.99
    const currentIdx = gameRanks.findIndex(r => r.id === currentRank)
    const desiredIdx = gameRanks.findIndex(r => r.id === desiredRank)
    if (currentIdx >= 0 && desiredIdx > currentIdx) basePrice = basePrice * (1 + (desiredIdx - currentIdx) * 0.5)
    if (currentIdx === desiredIdx && currentDivision > desiredDivision) basePrice = basePrice * (1 + (currentDivision - desiredDivision) * 0.1)
    const lpMod = LP_OPTIONS.find(l => l.value === lpPerWin)?.modifier || 1
    basePrice *= lpMod
    if (completionMethod === 'duo') basePrice *= 1.5
    if (extras.priorityOrder) basePrice *= 1.2
    if (extras.streaming) basePrice *= 1.1
    if (extras.specificRoles) basePrice += 0.60
    if (extras.specificChampions) basePrice += 1.80
    return Math.round(basePrice * 100) / 100
  }

  const handlePurchase = async () => {
    if (!user) { alert('Please login to purchase'); return }
    if (user.role !== 'buyer') { alert('Only buyers can purchase services'); return }
    try {
      const serviceTypeMap: Record<CategoryType, string> = { 'division_boost': 'elo_boost', 'placement': 'placement', 'win_boost': 'duo_boost', 'coaching': 'coaching', 'accounts': '', 'rp': '' }
      const matchingService = availableServices.find(s => s.game === gameId && s.serviceType === serviceTypeMap[selectedCategory])
      if (!matchingService) { alert('Service not available. Please contact support.'); return }
      const boostConfig: BoostConfig = { currentRank, currentDivision, desiredRank, desiredDivision, server: boostServer, queueType, specificRole: selectedRole !== 'Any Role' ? selectedRole : undefined, priorityOrder: extras.priorityOrder, streamingEnabled: extras.streaming, offlineMode: extras.offlineMode }
      await apiClient.boostOrders.create(matchingService.id, boostConfig, calculatePrice())
      setPurchaseSuccess(true)
    } catch (error) { console.error('Failed to create boost order:', error); alert('Failed to create order. Please try again.') }
  }

  const filteredProducts = products.filter(p => {
    if (searchTerm && !p.title.toLowerCase().includes(searchTerm.toLowerCase())) return false
    if (serverFilter !== 'all' && p.server !== serverFilter) return false
    if (rankFilter !== 'all' && p.rank !== rankFilter) return false
    return true
  })

  const servers = Array.from(new Set(products.map(p => p.server).filter(Boolean))) as string[]
  const ranks = Array.from(new Set(products.map(p => p.rank).filter(Boolean))) as string[]
  const getRankDivisions = (rankId: EloRank) => gameRanks.find(r => r.id === rankId)?.divisions || 4

  if (purchaseSuccess) {
    return (
      <div className="min-h-screen bg-dark-900 flex items-center justify-center">
        <div className="max-w-md mx-auto text-center">
          <div className="bg-dark-800 rounded-2xl p-8 border border-dark-700">
            <div className="w-20 h-20 bg-primary-500/20 rounded-full flex items-center justify-center mx-auto mb-6"><CheckCircle className="h-10 w-10 text-primary-400" /></div>
            <h2 className="text-2xl font-bold text-white mb-2">Order Placed!</h2>
            <p className="text-dark-400 mb-6">Your boost order has been placed successfully.</p>
            <div className="bg-dark-700 rounded-lg p-4 mb-6">
              <div className="flex justify-between text-sm mb-2"><span className="text-dark-400">Order Total</span><span className="text-primary-400 font-bold">${calculatePrice()}</span></div>
              <div className="flex justify-between text-sm"><span className="text-dark-400">Status</span><span className="text-yellow-400">Pending</span></div>
            </div>
            <button onClick={() => setPurchaseSuccess(false)} className="w-full bg-primary-500 text-dark-900 py-3 rounded-lg font-bold hover:bg-primary-400 transition-colors">Order Another Boost</button>
          </div>
        </div>
      </div>
    )
  }

  return (
    <div className="min-h-screen bg-dark-900">
      <div className="bg-dark-800 border-b border-dark-700">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
          <div className="flex items-center justify-between">
            <div className="flex items-center gap-4">
              <Link href="/" className="text-dark-400 hover:text-white transition-colors"><ArrowLeft className="h-5 w-5" /></Link>
              <h1 className="text-xl font-bold text-white uppercase tracking-wide">{getGameName()}</h1>
            </div>
            <div className="flex items-center gap-4 text-xs text-dark-400">
              <span className="flex items-center gap-1"><Zap className="h-3 w-3 text-green-400" /> Instant delivery</span>
              <span className="flex items-center gap-1"><Shield className="h-3 w-3 text-blue-400" /> SSL Secure</span>
              <span className="flex items-center gap-1"><CheckCircle className="h-3 w-3 text-green-400" /> Safe Service</span>
            </div>
          </div>
        </div>
      </div>

      <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
        <div className="flex gap-6">
          <div className="w-52 flex-shrink-0">
            <nav className="space-y-1">
              {categories.map((cat) => {
                const Icon = cat.icon
                const displayName = cat.id === 'rp' ? getCurrencyName() : cat.name
                return (
                  <button key={cat.id} onClick={() => setSelectedCategory(cat.id)} className={`w-full flex items-center justify-between px-3 py-2.5 rounded-lg text-sm transition-colors ${selectedCategory === cat.id ? 'bg-primary-500/20 text-primary-400 border border-primary-500/30' : 'text-dark-300 hover:bg-dark-800 hover:text-white border border-transparent'}`}>
                    <div className="flex items-center gap-2"><Icon className="h-4 w-4" /><span className="font-medium">{displayName}</span></div>
                    {selectedCategory === cat.id && <ChevronRight className="h-4 w-4" />}
                  </button>
                )
              })}
            </nav>
          </div>

          <div className="flex-1">
            {isBoostingCategory(selectedCategory) && (
              <div className="flex gap-6">
                <div className="flex-1">
                  <h2 className="text-2xl font-bold text-white mb-4">{getCategoryTitle()}</h2>
                  <div className="flex flex-wrap gap-2 mb-6">
                    <span className="px-3 py-1.5 bg-green-500/20 text-green-400 text-xs font-medium rounded-lg border border-green-500/30">Quick Start</span>
                    <span className="px-3 py-1.5 bg-purple-500/20 text-purple-400 text-xs font-medium rounded-lg border border-purple-500/30">Guaranteed Results</span>
                    <span className="px-3 py-1.5 bg-blue-500/20 text-blue-400 text-xs font-medium rounded-lg border border-blue-500/30">Fair Price</span>
                  </div>
                  <div className="bg-dark-800 rounded-xl border border-dark-700 p-4 mb-6">
                    <div className="flex gap-4">
                      <img src="https://images.unsplash.com/photo-1542751371-adc38448a05e?w=400" alt={getCategoryTitle()} className="w-32 h-32 rounded-lg object-cover" />
                      <div className="flex-1">
                        <div className="flex items-center gap-2 mb-2">
                          <div className="flex">{[1,2,3,4,5].map(i => <Star key={i} className="h-4 w-4 text-yellow-400 fill-yellow-400" />)}</div>
                          <span className="text-white font-bold">5.0</span>
                          <span className="text-dark-400 text-sm">Based on 1654 ratings</span>
                        </div>
                        <p className="text-dark-400 text-sm italic mb-2">"Staff is super nice and replies extremely quickly..."</p>
                        <button className="text-primary-400 text-sm hover:underline">More reviews →</button>
                      </div>
                    </div>
                  </div>
                  <div className="flex gap-6 mb-6">
                    <div className="flex items-center gap-2"><Clock className="h-5 w-5 text-dark-400" /><div><div className="text-white font-bold">10-15 min</div><div className="text-dark-400 text-xs">Estimated Start Time</div></div></div>
                    <div className="flex items-center gap-2"><Zap className="h-5 w-5 text-dark-400" /><div><div className="text-white font-bold">Flexible</div><div className="text-dark-400 text-xs">Estimated Completion Time</div></div></div>
                  </div>
                  <div className="flex flex-wrap gap-3 mb-6 text-xs text-dark-400">
                    <span className="flex items-center gap-1"><Shield className="h-3 w-3" /> SSL Secure</span>
                    <span className="flex items-center gap-1"><Shield className="h-3 w-3" /> VPN, Safe Boost</span>
                    <span className="flex items-center gap-1"><CheckCircle className="h-3 w-3" /> Safe Service</span>
                    <span className="flex items-center gap-1"><MessageCircle className="h-3 w-3" /> 24/7 Support</span>
                  </div>
                  <div className="mb-6">
                    <h3 className="text-lg font-bold text-white mb-3">Description</h3>
                    <p className="text-dark-300 text-sm leading-relaxed mb-4">Making your way up the competitive ladder is always a challenge. Whether you want to skip those first initial Divisions or place yourself among the best players, we can help you! All our players are professionals with many years of experience.</p>
                    <ul className="space-y-2 text-dark-300 text-sm">
                      <li className="flex items-center gap-2"><span className="text-primary-400 font-bold">1</span> Quick and efficient Elo boost</li>
                      <li className="flex items-center gap-2"><span className="text-primary-400 font-bold">2</span> Complete safety and guaranteed results</li>
                      <li className="flex items-center gap-2"><span className="text-primary-400 font-bold">3</span> With any Champions preferable</li>
                      <li className="flex items-center gap-2"><span className="text-primary-400 font-bold">4</span> Better statistics</li>
                    </ul>
                  </div>
                </div>

                <div className="w-96 flex-shrink-0">
                  <div className="bg-dark-800 rounded-xl border border-dark-700 p-5 sticky top-24">
                    <div className="mb-4">
                      <label className="block text-sm font-medium text-dark-300 mb-2">Choose Your Server:</label>
                      <div className="relative">
                        <select value={boostServer} onChange={(e) => setBoostServer(e.target.value)} className="w-full bg-dark-700 border border-dark-600 rounded-lg px-4 py-3 text-white appearance-none focus:border-primary-500 focus:outline-none">
                          {gameServers.map(server => <option key={server} value={server}>{server}</option>)}
                        </select>
                        <ChevronDown className="absolute right-3 top-1/2 -translate-y-1/2 h-5 w-5 text-dark-400 pointer-events-none" />
                      </div>
                    </div>
                    <div className="mb-4">
                      <label className="block text-sm font-medium text-dark-300 mb-2">Choose Your Current Rank:</label>
                      <div className="relative">
                        <select value={currentRank} onChange={(e) => setCurrentRank(e.target.value as EloRank)} className="w-full bg-dark-700 border border-dark-600 rounded-lg px-4 py-3 text-white appearance-none focus:border-primary-500 focus:outline-none">
                          {gameRanks.map(rank => <option key={rank.id} value={rank.id}>{rank.name}</option>)}
                        </select>
                        <ChevronDown className="absolute right-3 top-1/2 -translate-y-1/2 h-5 w-5 text-dark-400 pointer-events-none" />
                      </div>
                      {getRankDivisions(currentRank) > 1 && <div className="flex gap-2 mt-2">{Array.from({ length: getRankDivisions(currentRank) }, (_, i) => i + 1).reverse().map(div => <button key={div} onClick={() => setCurrentDivision(div)} className={`flex-1 py-2 rounded text-sm font-medium transition-colors ${currentDivision === div ? 'bg-primary-500 text-dark-900' : 'bg-dark-700 text-dark-300 hover:bg-dark-600'}`}>{div}</button>)}</div>}
                    </div>
                    <div className="mb-4">
                      <label className="block text-sm font-medium text-dark-300 mb-2">Choose Desired Rank:</label>
                      <div className="relative">
                        <select value={desiredRank} onChange={(e) => setDesiredRank(e.target.value as EloRank)} className="w-full bg-dark-700 border border-dark-600 rounded-lg px-4 py-3 text-white appearance-none focus:border-primary-500 focus:outline-none">
                          {gameRanks.map(rank => <option key={rank.id} value={rank.id}>{rank.name}</option>)}
                        </select>
                        <ChevronDown className="absolute right-3 top-1/2 -translate-y-1/2 h-5 w-5 text-dark-400 pointer-events-none" />
                      </div>
                      {getRankDivisions(desiredRank) > 1 && <div className="flex gap-2 mt-2">{Array.from({ length: getRankDivisions(desiredRank) }, (_, i) => i + 1).reverse().map(div => <button key={div} onClick={() => setDesiredDivision(div)} className={`flex-1 py-2 rounded text-sm font-medium transition-colors ${desiredDivision === div ? 'bg-primary-500 text-dark-900' : 'bg-dark-700 text-dark-300 hover:bg-dark-600'}`}>{div}</button>)}</div>}
                    </div>
                    <div className="mb-4">
                      <label className="block text-sm font-medium text-dark-300 mb-2">Your Avg LP per Win:</label>
                      <div className="relative">
                        <select value={lpPerWin} onChange={(e) => setLpPerWin(e.target.value)} className="w-full bg-dark-700 border border-dark-600 rounded-lg px-4 py-3 text-white appearance-none focus:border-primary-500 focus:outline-none">
                          {LP_OPTIONS.map(opt => <option key={opt.value} value={opt.value}>{opt.label}</option>)}
                        </select>
                        <ChevronDown className="absolute right-3 top-1/2 -translate-y-1/2 h-5 w-5 text-dark-400 pointer-events-none" />
                      </div>
                    </div>
                    <div className="mb-4">
                      <label className="block text-sm font-medium text-dark-300 mb-2">Queue Type:</label>
                      <div className="space-y-2">
                        <label className="flex items-center gap-3 cursor-pointer"><input type="radio" name="queueType" checked={queueType === 'solo'} onChange={() => setQueueType('solo')} className="w-4 h-4 accent-primary-500" /><span className="text-white">Solo Queue</span></label>
                        <label className="flex items-center gap-3 cursor-pointer"><input type="radio" name="queueType" checked={queueType === 'flex'} onChange={() => setQueueType('flex')} className="w-4 h-4 accent-primary-500" /><span className="text-white">Flex</span></label>
                      </div>
                    </div>
                    <div className="mb-4">
                      <label className="block text-sm font-medium text-dark-300 mb-2">Completion Method:</label>
                      <div className="space-y-2">
                        <label className="flex items-center justify-between cursor-pointer"><div className="flex items-center gap-3"><input type="radio" name="completionMethod" checked={completionMethod === 'piloted'} onChange={() => setCompletionMethod('piloted')} className="w-4 h-4 accent-primary-500" /><span className="text-white">Piloted</span></div></label>
                        <label className="flex items-center justify-between cursor-pointer"><div className="flex items-center gap-3"><input type="radio" name="completionMethod" checked={completionMethod === 'duo'} onChange={() => setCompletionMethod('duo')} className="w-4 h-4 accent-primary-500" /><span className="text-white">Duo (Self-play)</span></div><span className="text-primary-400 text-sm">+$4.79</span></label>
                      </div>
                    </div>
                    <div className="mb-4">
                      <label className="block text-sm font-medium text-dark-300 mb-2">A PRO Should Play:</label>
                      <div className="relative">
                        <select value={selectedRole} onChange={(e) => setSelectedRole(e.target.value)} className="w-full bg-dark-700 border border-dark-600 rounded-lg px-4 py-3 text-white appearance-none focus:border-primary-500 focus:outline-none">
                          {LOL_ROLES.map(role => <option key={role} value={role}>{role}</option>)}
                        </select>
                        <ChevronDown className="absolute right-3 top-1/2 -translate-y-1/2 h-5 w-5 text-dark-400 pointer-events-none" />
                      </div>
                    </div>
                    <div className="mb-6">
                      <label className="block text-sm font-medium text-dark-300 mb-2">Choose Extras:</label>
                      <div className="space-y-2">
                        <label className="flex items-center justify-between cursor-pointer p-2 rounded hover:bg-dark-700"><div className="flex items-center gap-3"><input type="checkbox" checked={extras.priorityOrder} onChange={(e) => setExtras({...extras, priorityOrder: e.target.checked})} className="w-4 h-4 accent-primary-500" /><span className="text-white text-sm">Priority Order</span></div><span className="text-primary-400 text-sm">+$1.80</span></label>
                        <label className="flex items-center justify-between cursor-pointer p-2 rounded hover:bg-dark-700"><div className="flex items-center gap-3"><input type="checkbox" checked={extras.specificRoles} onChange={(e) => setExtras({...extras, specificRoles: e.target.checked})} className="w-4 h-4 accent-primary-500" /><span className="text-white text-sm">Specific Roles</span></div><span className="text-primary-400 text-sm">+$0.60</span></label>
                        <label className="flex items-center justify-between cursor-pointer p-2 rounded hover:bg-dark-700"><div className="flex items-center gap-3"><input type="checkbox" checked={extras.specificChampions} onChange={(e) => setExtras({...extras, specificChampions: e.target.checked})} className="w-4 h-4 accent-primary-500" /><span className="text-white text-sm">Specific Champions</span></div><span className="text-primary-400 text-sm">+$1.80</span></label>
                      </div>
                    </div>
                    <div className="bg-dark-700 rounded-lg p-4 mb-4">
                      <div className="flex items-center justify-between mb-2"><span className="text-dark-300">Total</span><span className="text-3xl font-bold text-primary-400">${calculatePrice()}</span></div>
                      <div className="text-dark-400 text-xs">$0.30 cashback after purchase</div>
                    </div>
                    <button onClick={handlePurchase} className="w-full bg-primary-500 hover:bg-primary-400 text-dark-900 py-4 rounded-lg font-bold text-lg transition-colors flex items-center justify-center gap-2">Buy now <Heart className="h-5 w-5" /></button>
                    <div className="flex items-center justify-center gap-2 mt-4 text-dark-500 text-xs"><span>PayPal</span><span>•</span><span>VISA</span><span>•</span><span>G Pay</span><span>•</span><span>Skrill</span></div>
                    <div className="mt-4 pt-4 border-t border-dark-600">
                      <div className="text-center text-dark-400 text-xs mb-2">Any questions?</div>
                      <button className="w-full bg-dark-700 hover:bg-dark-600 text-white py-2 rounded-lg text-sm transition-colors flex items-center justify-center gap-2"><MessageCircle className="h-4 w-4" /> Chat before order</button>
                    </div>
                  </div>
                </div>
              </div>
            )}

            {!isBoostingCategory(selectedCategory) && (
              <>
                <div className="mb-6">
                  <div className="flex items-center gap-4 mb-4">
                    <div className="flex-1 relative">
                      <Search className="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-dark-400" />
                      <input type="text" placeholder="Search" value={searchTerm} onChange={(e) => setSearchTerm(e.target.value)} className="w-full pl-10 pr-4 py-2.5 bg-dark-800 border border-dark-700 rounded-lg text-white placeholder-dark-400 focus:border-primary-500 focus:outline-none" />
                    </div>
                  </div>
                  {selectedCategory === 'accounts' && (
                    <div className="flex gap-4 mb-4">
                      <select value={serverFilter} onChange={(e) => setServerFilter(e.target.value)} className="px-4 py-2 bg-dark-800 border border-dark-700 rounded-lg text-white focus:border-primary-500 focus:outline-none">
                        <option value="all">Server</option>
                        {servers.map(server => <option key={server} value={server}>{server}</option>)}
                      </select>
                      <select value={rankFilter} onChange={(e) => setRankFilter(e.target.value)} className="px-4 py-2 bg-dark-800 border border-dark-700 rounded-lg text-white focus:border-primary-500 focus:outline-none">
                        <option value="all">Rank</option>
                        {ranks.map(rank => <option key={rank} value={rank}>{rank}</option>)}
                      </select>
                    </div>
                  )}
                  <div className="text-dark-400 text-sm mb-4">{filteredProducts.length} offers available</div>
                </div>
                <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                  {filteredProducts.map((product) => (
                    <div key={product.id} onClick={() => handleProductClick(product.id)} className="bg-dark-800 rounded-xl border border-dark-700 overflow-hidden hover:border-primary-500/50 transition-all cursor-pointer group">
                      <div className="relative h-48">
                        <img src={product.imageUrl} alt={product.title} className="w-full h-full object-cover" />
                        {product.isHandmade && <span className="absolute top-3 left-3 px-2 py-1 bg-green-500/90 text-white text-xs font-medium rounded flex items-center gap-1"><Zap className="h-3 w-3" /> Instant delivery</span>}
                        <span className="absolute bottom-3 right-3 px-2 py-1 bg-dark-900/80 text-white text-xs rounded">{product.stock} in stock</span>
                      </div>
                      <div className="p-4">
                        <div className="flex items-center gap-2 mb-2">
                          {product.server && <span className="text-primary-400 font-bold text-sm">{product.server}</span>}
                          {product.rank && <span className="text-dark-400 text-sm">· {product.rank}</span>}
                        </div>
                        <p className="text-dark-300 text-sm mb-3 line-clamp-2">{product.description}</p>
                        {product.productType === 'account' && (
                          <div className="flex flex-wrap gap-2 mb-4">
                            {product.blueEssence && <span className="px-2 py-1 bg-dark-700 text-dark-300 text-xs rounded">BE: {product.blueEssence.toLocaleString()}</span>}
                            {product.level && <span className="px-2 py-1 bg-dark-700 text-dark-300 text-xs rounded">Lvl {product.level}</span>}
                            {product.championsCount && <span className="px-2 py-1 bg-dark-700 text-dark-300 text-xs rounded">{product.championsCount} Champs</span>}
                          </div>
                        )}
                        <div className="flex items-center justify-between pt-3 border-t border-dark-700">
                          <div className="flex items-center gap-2">
                            <div className="w-8 h-8 bg-dark-700 rounded-full flex items-center justify-center"><User className="h-4 w-4 text-dark-400" /></div>
                            <div>
                              <div className="text-white text-sm font-medium">{product.sellerName}</div>
                              <div className="flex items-center gap-1"><Star className="h-3 w-3 text-yellow-400 fill-yellow-400" /><span className="text-yellow-400 text-xs">{product.sellerRating.toFixed(1)}</span><span className="text-dark-400 text-xs">({product.sellerTotalReviews})</span></div>
                            </div>
                          </div>
                        </div>
                        <div className="flex items-center justify-between mt-4">
                          <div className="text-2xl font-bold text-white">${product.price.toFixed(2).split('.')[0]}<span className="text-lg text-dark-400">.{product.price.toFixed(2).split('.')[1]}</span></div>
                          <button className="px-4 py-2 bg-primary-500 hover:bg-primary-400 text-dark-900 font-bold rounded-lg transition-colors flex items-center gap-1">Buy now <ChevronRight className="h-4 w-4" /></button>
                        </div>
                      </div>
                    </div>
                  ))}
                </div>
                {filteredProducts.length === 0 && !loading && (
                  <div className="text-center py-12"><Package className="h-16 w-16 text-dark-600 mx-auto mb-4" /><p className="text-dark-400">No products available in this category.</p></div>
                )}
              </>
            )}
            {loading && <div className="text-center py-12"><p className="text-dark-400">Loading...</p></div>}
          </div>
        </div>
      </div>
    </div>
  )
}
